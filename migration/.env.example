# ────────────────────────────────────────────────────────────────────────────
#  LUMENGRID — Variáveis de Ambiente para Migração
#  Copie este arquivo para .env e preencha com seus dados reais
#  NUNCA suba o .env para o git (já está no .gitignore)
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# (use a SERVICE_ROLE key para o script de migração, não a anon key)

# ── Google Sheets API ─────────────────────────────────────────────────────────
# Encontre em: console.cloud.google.com → IAM → Service Accounts → sua conta → Keys
# Baixe o JSON e coloque o caminho aqui, ou cole o conteúdo em GOOGLE_SA_JSON
GOOGLE_SA_KEY_FILE=./google-service-account.json
# Alternativa: cole o JSON inteiro como string (para deploy CI/CD)
# GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}

# ── IDs das Planilhas Google Sheets ──────────────────────────────────────────
# Encontre na URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
SHEET_ID_CRM=1LTv6dFRT56533gfPc5elNfxiddsUzgYyLbCLsNykyRQ
SHEET_ID_FIN=1yCgNm9BMHjnrOFs9_txBpik3nnR4GVivs8F3m-QqiWw
SHEET_ID_CONTRATOS=145EgaXS8Jz1i5NEAWPhHJ9SoOE-Tzs9247vYsrxIR2o
SHEET_ID_PARCEIROS=1PoXQTLBfciYHSqQZn1ryHEx_0C6TQn5jDDyGNavGLuo
SHEET_ID_LEADS=
SHEET_ID_CHECKLIST=
SHEET_ID_VIDEOS=

# ── Configurações ─────────────────────────────────────────────────────────────
# Pasta para salvar backups JSON locais (relativa ao diretório migration/)
BACKUP_DIR=../BACKUPS
# Rodar em modo dry-run (true = não escreve no banco, só mostra o que faria)
DRY_RUN=false
